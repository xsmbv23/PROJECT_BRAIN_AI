{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MULTI_BOT_DELIBERATION_V2",
  "title": "Forensic Multi-Bot Deliberation Protocol",
  "description": "Official protocol for Bot1, Bot2 and Bot3 exchange, challenge, evidence review, synthesis and escalation. Consensus never substitutes for evidence or a local admission gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "deliberation_id",
    "e2e_segment",
    "blocker",
    "proposer",
    "reviewers",
    "proposal",
    "evidence_refs",
    "assumptions",
    "positions",
    "objections_and_replies",
    "synthesized_decision",
    "chosen_owner",
    "safe_parallel_work",
    "unresolved_questions",
    "next_action",
    "forensic_state_transition"
  ],
  "properties": {
    "contract_id": {"const": "MULTI_BOT_DELIBERATION_V2"},
    "deliberation_id": {"type": "string", "minLength": 1},
    "e2e_segment": {"type": "string", "minLength": 1},
    "blocker": {"type": "string", "minLength": 1},
    "proposer": {"$ref": "#/$defs/bot"},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/bot"}
    },
    "proposal": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "positions": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/position"}
    },
    "objections_and_replies": {
      "type": "array",
      "items": {"$ref": "#/$defs/objection"}
    },
    "synthesized_decision": {"$ref": "#/$defs/decision"},
    "chosen_owner": {"$ref": "#/$defs/bot"},
    "safe_parallel_work": {
      "type": "array",
      "items": {"type": "string"}
    },
    "unresolved_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "next_action": {"type": "string", "minLength": 1},
    "forensic_state_transition": {"$ref": "#/$defs/stateTransition"}
  },
  "$defs": {
    "bot": {
      "type": "string",
      "enum": ["BOT1_LEAD", "BOT2_QUANT", "BOT3_EXECUTION"]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bot", "position", "claim", "evidence_refs", "confidence", "blocking"],
      "properties": {
        "bot": {"$ref": "#/$defs/bot"},
        "position": {"enum": ["AGREE", "CHALLENGE", "CONDITIONAL", "UNKNOWN"]},
        "claim": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "blocking": {"type": "boolean"}
      }
    },
    "objection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raised_by", "target_bot", "objection", "reply", "reply_evidence_refs", "resolved"],
      "properties": {
        "raised_by": {"$ref": "#/$defs/bot"},
        "target_bot": {"$ref": "#/$defs/bot"},
        "objection": {"type": "string", "minLength": 1},
        "reply": {"type": "string"},
        "reply_evidence_refs": {"type": "array", "items": {"type": "string"}},
        "resolved": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason", "evidence_refs", "gate_status", "minority_preserved"],
      "properties": {
        "outcome": {"enum": ["PASS", "DENY", "HOLD", "ESCALATE"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "gate_status": {"enum": ["PASS", "DENY", "UNKNOWN", "NOT_REACHED"]},
        "minority_preserved": {"type": "boolean"}
      }
    },
    "stateTransition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["previous", "proposed", "authorized_by_local_gate", "evidence_required", "evidence_present"],
      "properties": {
        "previous": {"type": "string"},
        "proposed": {"type": "string"},
        "authorized_by_local_gate": {"type": "boolean"},
        "evidence_required": {"type": "array", "items": {"type": "string"}},
        "evidence_present": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "protocol": {
    "role_separation": {
      "BOT1_LEAD": "Owns orchestration, scope, gate interpretation and synthesis. BOT1 cannot manufacture evidence or override a local gate.",
      "BOT2_QUANT": "Owns quantitative/analytical challenge, calculations, assumptions and statistical objections. BOT2 cannot promote a state by calculation alone.",
      "BOT3_EXECUTION": "Owns implementation/execution feasibility, operational safety, resource/OOM constraints and deployment evidence. BOT3 cannot alter forensic truth to make deployment green."
    },
    "exchange_order": [
      "1_PROPOSE",
      "2_INDEPENDENT_REVIEW",
      "3_CHALLENGE",
      "4_REPLY_WITH_EVIDENCE",
      "5_REBUTTAL_OR_ACCEPTANCE",
      "6_SYNTHESIS",
      "7_LOCAL_GATE_CHECK",
      "8_STATE_TRANSITION_OR_HOLD",
      "9_PERSIST_ACTION_LOG",
      "10_ASSIGN_NEXT_ACTION"
    ],
    "mandatory_challenge": true,
    "independent_review_before_synthesis": true,
    "bot_cannot_approve_own_unreviewed_claim": true,
    "agreement_is_not_evidence": true,
    "majority_vote_is_not_evidence": true,
    "consensus_is_not_a_gate": true,
    "proposal_is_not_evidence": true,
    "unknown_is_not_pass": true,
    "unknown_is_not_agree": true,
    "missing_evidence_requires_hold_or_deny": true,
    "minority_position_must_be_preserved": true,
    "blocking_objection_must_be_resolved_or_recorded": true,
    "historical_decisions_are_immutable": true,
    "new_evidence_creates_new_action_record": true,
    "state_transition_requires_local_gate_evidence": true,
    "bots_may_parallelize_only_safe_independent_work": true,
    "bots_must_not_mutate_canonical_source_truth": true,
    "chat_is_interface_not_authority": true,
    "repository_and_persistent_evidence_are_authority": true,
    "credential_secrets_are_forbidden_in_deliberation_records": true,
    "forensic_hashes_are_allowed_but_raw_secrets_are_not": true,
    "escalation_conditions": [
      "conflicting evidence",
      "unresolved blocking objection",
      "unknown critical dependency",
      "requested state promotion without local gate evidence",
      "security boundary ambiguity",
      "source truth conflict"
    ],
    "escalation_outcome": "ESCALATE or HOLD; never silently choose PASS"
  },
  "invariants": {
    "forensic_admission_chain": [
      "EXISTENCE",
      "BINDING",
      "TLS_ADMISSION",
      "ROUND_TRIP_EVIDENCE",
      "PROMOTION"
    ],
    "gate_states_do_not_inherit_automatically": true,
    "db_exists_does_not_imply_db_bound": true,
    "db_bound_tls_does_not_imply_round_trip": true,
    "round_trip_does_not_erase_historical_denials": true,
    "layer_1_locked_until_foundation_gate_pass": true,
    "staircase_locked_until_foundation_gate_pass": true
  }
}
