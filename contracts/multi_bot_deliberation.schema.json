{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "MULTI_BOT_DELIBERATION_V2",
  "title": "Forensic Multi-Bot Deliberation Protocol V2",
  "description": "Deliberation is a reasoning and recommendation layer on top of ONE FORENSIC FSM. It never creates evidence, never owns a forensic gate, never becomes Quant truth, and never authorizes promotion.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "deliberation_id",
    "historical_only",
    "e2e_segment",
    "blocker",
    "proposer",
    "reviewers",
    "proposal",
    "evidence_refs",
    "assumptions",
    "positions",
    "dissents",
    "objections_and_replies",
    "rounds",
    "synthesized_decision",
    "next_action"
  ],
  "properties": {
    "contract_id": {"const": "MULTI_BOT_DELIBERATION_V2"},
    "deliberation_id": {"type": "string", "minLength": 1},
    "historical_only": {"const": true},
    "e2e_segment": {"type": "string", "minLength": 1},
    "blocker": {"type": "string", "minLength": 1},
    "proposer": {"$ref": "#/$defs/bot"},
    "reviewers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/bot"}
    },
    "proposal": {"type": "string", "minLength": 1},
    "evidence_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "positions": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/position"}
    },
    "dissents": {
      "type": "array",
      "items": {"$ref": "#/$defs/dissent"}
    },
    "objections_and_replies": {
      "type": "array",
      "items": {"$ref": "#/$defs/objection"}
    },
    "rounds": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/round"}
    },
    "synthesized_decision": {"$ref": "#/$defs/decision"},
    "next_action": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "bot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bot_id", "domain_authority", "deliberation_role"],
      "properties": {
        "bot_id": {"enum": ["BOT1_LEAD", "BOT2_QUANT", "BOT3_EXECUTION"]},
        "domain_authority": {"enum": ["GOVERNANCE", "QUANT", "EXECUTION"]},
        "deliberation_role": {"enum": ["PROPOSER", "ADVERSARIAL_REVIEWER", "INDEPENDENT_ARBITER", "SYNTHESIZER"]}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "record_ref", "record_sha256", "gate_owner", "execution_id", "status"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "record_ref": {"type": "string", "minLength": 1},
        "record_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gate_owner": {"enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "DB_EXISTENCE", "DB_BINDING", "DB_TLS_ADMISSION", "DB_ROUND_TRIP", "NONE"]},
        "execution_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["OBSERVED", "VERIFIED", "UNKNOWN", "DENIED"]}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bot", "position", "claim", "evidence_refs", "confidence", "blocking"],
      "properties": {
        "bot": {"$ref": "#/$defs/bot"},
        "position": {"enum": ["AGREE", "CHALLENGE", "CONDITIONAL", "UNKNOWN"]},
        "claim": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "blocking": {"type": "boolean"}
      }
    },
    "dissent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bot", "claim", "reason", "evidence_refs", "resolved"],
      "properties": {
        "bot": {"$ref": "#/$defs/bot"},
        "claim": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "resolved": {"type": "boolean"}
      }
    },
    "objection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raised_by", "target_bot", "objection", "reply", "reply_evidence_refs", "resolved"],
      "properties": {
        "raised_by": {"$ref": "#/$defs/bot"},
        "target_bot": {"$ref": "#/$defs/bot"},
        "objection": {"type": "string", "minLength": 1},
        "reply": {"type": "string"},
        "reply_evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/evidenceRef"}},
        "resolved": {"type": "boolean"}
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round_id", "kind", "immutable", "entries"],
      "properties": {
        "round_id": {"type": "integer", "minimum": 1},
        "kind": {"enum": ["PROPOSAL", "CHALLENGE", "REBUTTAL", "ARBITRATION", "EVIDENCE_REQUEST", "CLARIFICATION"]},
        "immutable": {"const": true},
        "entries": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "outcome", "reason", "recommendation", "minority_preserved", "gate_outcome", "quant_outcome", "execution_outcome"],
      "properties": {
        "scope": {"const": "DELIBERATION_ONLY"},
        "outcome": {"enum": ["ACCEPTED", "REJECTED", "HOLD", "ESCALATE", "UNRESOLVED"]},
        "reason": {"type": "string", "minLength": 1},
        "recommendation": {"type": "string", "minLength": 1},
        "minority_preserved": {"const": true},
        "gate_outcome": {"const": "UNCHANGED"},
        "quant_outcome": {"const": "UNCHANGED"},
        "execution_outcome": {"const": "UNCHANGED"}
      }
    }
  },
  "protocol": {
    "role_separation": {
      "BOT1_LEAD": "Owns orchestration, scope, gate interpretation and synthesis; may not manufacture evidence or override a local gate.",
      "BOT2_QUANT": "Owns quantitative/analytical challenge; may not promote a forensic gate by calculation or consensus.",
      "BOT3_EXECUTION": "Owns implementation/runtime challenge; may not alter forensic truth or create a gate outcome."
    },
    "capability_boundary_is_independent_of_deliberation_role": true,
    "minimum_lifecycle": ["PROPOSAL", "CHALLENGE", "REBUTTAL", "ARBITRATION"],
    "arbitration_requires_prior_challenge": true,
    "deliberation_is_historical_only": true,
    "deliberation_outcome_is_not_gate_outcome": true,
    "deliberation_outcome_is_not_quant_outcome": true,
    "deliberation_outcome_is_not_execution_outcome": true,
    "evidence_refs_must_resolve_to_persistent_records": true,
    "minority_position_must_be_preserved": true,
    "dissent_is_immutable_after_round_close": true,
    "rounds_are_append_only": true,
    "revision_requires_new_record": true,
    "successor_bots_must_not_inherit_truth_from_consensus": true,
    "successor_bots_inherit_rationale_not_truth": true,
    "doctrine_can_define_required_evidence_but_cannot_prove_reality": true,
    "bots_may_parallelize_only_safe_independent_work": true,
    "state_transition_requires_local_gate_evidence_outside_deliberation": true,
    "credentials_and_raw_secrets_forbidden": true
  },
  "forbidden_patterns": [
    "decision.outcome = PASS",
    "decision.outcome = DENY",
    "deliberation_authorizes_promotion",
    "deliberation_modifies_canonical_truth",
    "consensus_inherits_gate_status",
    "minority_overwritten",
    "arbitration_before_challenge",
    "closed_round_rewritten"
  ]
}