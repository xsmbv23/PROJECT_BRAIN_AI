{
  "contract_id":"S1_EVIDENCE_ACQUISITION_V1",
  "purpose":"Define admissible acquisition channels for S1 without making automated web scraping a prerequisite.",
  "allowed_channels":[
    "AUTOMATED_SOURCE_WITH_EXPLICIT_PERMISSION",
    "MANUAL_AUTHORIZED_CAPTURE",
    "DURABLE_ARCHIVE_EXPORT"
  ],
  "forbidden_channels":[
    "UNAUTHORIZED_AUTOMATED_COLLECTION",
    "SYNTHETIC_GENERATION",
    "UNTRACEABLE_COPY",
    "CHAT_ASSERTION_ONLY"
  ],
  "channel_rules":{
    "AUTOMATED_SOURCE_WITH_EXPLICIT_PERMISSION":"source_identity + permission_reference + retrieval_timestamp + immutable_raw_bytes",
    "MANUAL_AUTHORIZED_CAPTURE":"operator_identity + authorization_reference + capture_timestamp + immutable_raw_bytes",
    "DURABLE_ARCHIVE_EXPORT":"archive_identity + export_timestamp + immutable_raw_bytes + archive_provenance"
  },
  "common_requirements":[
    "real_source_provenance",
    "artifact_path",
    "raw_byte_sha256",
    "coverage_ratio_1.0",
    "zero_unresolved_conflicts",
    "real_admission_receipt",
    "frozen_canonical_sha256",
    "synthetic_data_false"
  ],
  "independence_rule":"Source independence is one possible corroboration path, not a requirement that the data be automatically scraped from multiple websites.",
  "failure_policy":"DEFAULT_DENY",
  "unknown_policy":"NOT_PASS",
  "credential_policy":"NO_CREDENTIALS_IN_EVIDENCE_MANIFEST"
}
