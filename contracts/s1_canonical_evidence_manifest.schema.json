{
  "contract_id": "S1_CANONICAL_EVIDENCE_V2",
  "purpose": "admit only real evidence-backed canonical data into S2",
  "required": [
    "source_provenance",
    "acquisition_channel",
    "acquisition_reference",
    "acquisition_timestamp_utc",
    "artifact_path",
    "canonical_artifact_path",
    "raw_artifact_sha256",
    "raw_byte_sha256",
    "date_start",
    "date_end",
    "expected_consecutive_days",
    "observed_consecutive_days",
    "coverage_ratio",
    "unresolved_conflicts",
    "admission_receipt",
    "frozen_canonical_sha256",
    "synthetic_data"
  ],
  "admission_conditions": {
    "source_provenance": "REAL_AND_TRACEABLE",
    "acquisition_channel": "AUTOMATED_SOURCE_WITH_EXPLICIT_PERMISSION|MANUAL_AUTHORIZED_CAPTURE|DURABLE_ARCHIVE_EXPORT",
    "acquisition_reference": "PRESENT_AND_VERIFIABLE_FOR_CHANNEL",
    "acquisition_timestamp_utc": "PRESENT_AND_VERIFIABLE",
    "artifact_path": "MUST_RESOLVE_INSIDE_EVIDENCE_ROOT",
    "canonical_artifact_path": "MUST_RESOLVE_INSIDE_EVIDENCE_ROOT_AND_BE_EXPLICIT",
    "raw_artifact_sha256": "PRESENT_AND_VERIFIABLE_AGAINST_BYTES",
    "raw_byte_sha256": "PRESENT_AND_VERIFIABLE",
    "coverage_ratio": 1.0,
    "unresolved_conflicts": 0,
    "admission_receipt": "REAL_OBSERVABLE_RECEIPT",
    "frozen_canonical_sha256": "PRESENT_AND_VERIFIABLE_AGAINST_CANONICAL_BYTES",
    "synthetic_data": false
  },
  "admission_channel_policy": {
