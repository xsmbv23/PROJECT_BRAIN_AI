    "MANUAL_AUTHORIZED_CAPTURE": "requires operator identity + authorization reference + capture timestamp",
    "DURABLE_ARCHIVE_EXPORT": "requires archive identity + export timestamp + archive provenance"
  },
  "failure_policy": "DEFAULT_DENY",
  "unknown_policy": "NOT_PASS",
  "pass_inheritance": false,
