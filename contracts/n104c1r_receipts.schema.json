{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "N104C.1R_RECEIPTS_V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["network_origin", "state_drift"],
  "properties": {
    "network_origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "resolved_ip", "tls_version", "certificate_sha256", "http_status", "response_sha256", "timestamp_utc"],
      "properties": {
        "source": {"const": "ketqua16.net"},
        "resolved_ip": {"type": "string", "minLength": 1},
        "tls_version": {"enum": ["TLSv1.2", "TLSv1.3"]},
        "certificate_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "http_status": {"const": 200},
        "response_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
        "timestamp_utc": {"type": "string", "minLength": 1}
      }
    },
    "state_drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "runtime", "match", "timestamp_utc"],
      "properties": {
        "repo": {"type": "object", "additionalProperties": false},
        "runtime": {"type": "object", "additionalProperties": false},
        "match": {"const": true},
        "timestamp_utc": {"type": "string", "minLength": 1}
      }
    }
  }
}
